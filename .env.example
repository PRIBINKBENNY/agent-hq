# Copy to .env. Every key is a free sign-up, no card. Leave blank what you do not have.
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai            ~60K tokens/min, 1M/day   <- best first choice
GROQ_API_KEY=            # https://console.groq.com/keys        ~8K tokens/min per model
MISTRAL_API_KEY=         # https://console.mistral.ai           Experiment plan (prompts may be used for training)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey   ~15 req/min on Flash

# Order the office tries providers in (only ones with keys are used). Ollama is always last.
# PROVIDER_ORDER=cerebras,groq,mistral,gemini
# Per-provider model lists (leads try the first, workers the first):
# CEREBRAS_LEAD_MODELS=gpt-oss-120b,qwen-3.8-27b
# CEREBRAS_WORKER_MODELS=qwen-3.8-27b,gpt-oss-120b
# GROQ_LEAD_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_WORKER_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# OLLAMA_MODEL=llama3.2:3b
# OFFICE_MAX_TURNS=20

# Remote control (phone app). Generated automatically on first run if missing.
# DASHBOARD_TOKEN=            # login password for the dashboard when reached from outside this Mac
# VAPID_PRIVATE_KEY=          # web push keys (phone notifications)
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Capital.com (free demo account: virtual money, real markets). Settings > API integrations in the Capital.com app.
# CAPITAL_API_KEY=
# CAPITAL_IDENTIFIER=you@example.com      # the login email
# CAPITAL_PASSWORD=                       # the API key password you set when creating the key
# CAPITAL_DEMO=1                          # 1 = demo endpoint (default and enforced). Live needs CAPITAL_LIVE=I_UNDERSTAND_REAL_MONEY
