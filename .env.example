# Copy to .env. Every key is a free sign-up, no card. Leave blank what you do not have.
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai            ~60K tokens/min, 1M/day   <- best first choice
GROQ_API_KEY=            # https://console.groq.com/keys        ~8K tokens/min per model
MISTRAL_API_KEY=         # https://console.mistral.ai           Experiment plan (prompts may be used for training)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey   free Flash tier, no card (limits shown per project in AI Studio)
NVIDIA_API_KEY=          # https://build.nvidia.com              free with an email sign-up, no card, ~40 req/min, 100+ open models
OLLAMA_CLOUD_API_KEY=    # https://ollama.com (Settings > Keys)   free account, no card, big open models, unpublished session/weekly limits
KILO_ENABLED=0           # 1 = use Kilo Gateway's keyless ":free" routes (~200 req/hour per IP). No key, no card; prompts are logged for training.
# FREELLMAPI_URL=http://localhost:3000/v1   # optional self-hosted FreeLLMAPI router; set FREELLMAPI_KEY and ROUTER_LEAD_MODELS/ROUTER_WORKER_MODELS
ZAI_API_KEY=             # https://z.ai (API keys in the console)   free sign-up, no card, GLM Flash models at $0, ~1 req/s, ~1,000/day
OPENROUTER_API_KEY=      # https://openrouter.ai/settings/keys    free sign-up, no card, ":free" models, 20 req/min, 50 req/day
CLOUDFLARE_API_TOKEN=    # https://dash.cloudflare.com (Workers AI token) free 10,000 neurons/day, no card
CLOUDFLARE_ACCOUNT_ID=   # shown on the Cloudflare dashboard overview

# Order the office tries providers in (only ones with keys are used). Ollama is always last.
# PROVIDER_ORDER=cerebras,groq,gemini,mistral,nvidia,zai,ollamacloud,kilo,openrouter,cloudflare,router
# Per-provider model lists (leads try the first, workers the first):
# CEREBRAS_LEAD_MODELS=gpt-oss-120b,qwen-3.8-27b
# CEREBRAS_WORKER_MODELS=qwen-3.8-27b,gpt-oss-120b
# GROQ_LEAD_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_WORKER_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# OLLAMA_MODEL=qwen2.5:3b              # the uncapped floor: local, free, tool-capable (ollama pull qwen2.5:3b); qwen3:4b is smarter but slower
# OFFICE_LEAD_LOCAL_FALLBACK=1         # leads also run locally once every cloud model has been cooling for OFFICE_LEAD_WAIT_MAX (600s)
# OFFICE_MAX_TURNS=20

# Remote control (phone app). Generated automatically on first run if missing.
# DASHBOARD_TOKEN=            # login password for the dashboard when reached from outside this Mac
# VAPID_PRIVATE_KEY=          # web push keys (phone notifications)
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Capital.com (free demo account: virtual money, real markets). Settings > API integrations in the Capital.com app.
# CAPITAL_API_KEY=
# CAPITAL_IDENTIFIER=you@example.com      # the login email
# CAPITAL_PASSWORD=                       # the API key password you set when creating the key
# CAPITAL_DEMO=1                          # 1 = demo endpoint (default and enforced). Live needs CAPITAL_LIVE=I_UNDERSTAND_REAL_MONEY

# LinkedIn posting (free self-serve app: https://www.linkedin.com/developers/apps, products "Share on LinkedIn" + "Sign In with OpenID Connect")
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:8787/linkedin/callback
# LINKEDIN_VERSION=202608

# Gmail for the mail-assistant (free: an App Password on a Google account with 2-Step Verification; see office/mail.py)
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx     # myaccount.google.com/apppasswords
# MAIL_AUTOREPLY=0                           # 1 = answer inside EXISTING known-contact threads without approval; new recipients always need approval
# MAIL_DAILY_CAP=20                          # hard cap on emails sent per day
# MAIL_BLOCKLIST=                            # comma-separated addresses or domains never to email
# OBSIDIAN_VAULT=/Users/you/Documents/MyVault   # office notes are written to <vault>/Agent HQ/, Inbox/ is read back
